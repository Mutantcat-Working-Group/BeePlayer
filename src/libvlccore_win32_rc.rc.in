#define VERSION_NUMBER @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_RESOURCE_HIGH@,@VERSION_RESOURCE_LOW@
#define VERSION_NUMBER_STR "@VERSION@"

#include <winuser.h>

1 VERSIONINFO
FILETYPE 2
FILEOS 4
PRODUCTVERSION VERSION_NUMBER
FILEVERSION VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Mutantcat"
      VALUE "ProductName", "BeePlayer"
      VALUE "ProductVersion", VERSION_NUMBER_STR
      VALUE "FileVersion", "@VERSION@"
      VALUE "FileDescription", "BeePlayer"
      VALUE "LegalCopyright", "Copyright \251 @COPYRIGHT_YEARS@ Mutantcat and BeePlayer Authors"
      VALUE "LegalTrademarks", "BeePlayer and Mutantcat are trademarks of Mutantcat Working Group"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

ISOLATIONAWARE_MANIFEST_RESOURCE_ID RT_MANIFEST "libvlccore.dll.manifest"
